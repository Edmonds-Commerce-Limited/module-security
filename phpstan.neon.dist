includes:
    - vendor/bitexpert/phpstan-magento/extension.neon

parameters:
    level: 6
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - vendor
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    checkExplicitMixedMissingReturn: true
    checkPhpDocMissingReturn: true
